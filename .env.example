# CLEARPATH Environment Configuration
PORT=3001
NODE_ENV=development

# AI Service Configuration
# If GEMINI_API_KEY is not provided, CLEARPATH runs in transparent, verified rule-based demonstration mode.
GEMINI_API_KEY=

# Database Configuration (Optional - defaults to memory/local workspace store)
DATABASE_URL=

# Application Security
SESSION_SECRET=clearpath_secure_session_secret_change_in_prod
